+function notebookRangeToTextRange(notebook: vscode.NotebookDocument, notebookRange: vscode.NotebookRange): vscode.Range | undefined {
+    const cells = notebook.getCells(notebookRange)
+    if (cells.length === 0) return undefined
+
+    const firstCell = cells[0]
+    const lastCell = cells[cells.length - 1]
+
+    // Get the full range of all selected cells
+    const startPos = firstCell.document.positionAt(0)
+    const endPos = lastCell.document.positionAt(lastCell.document.getText().length)
+
+    return new vscode.Range(startPos, endPos)
+}
